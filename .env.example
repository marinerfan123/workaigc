# ── 服务 ──
NODE_ENV=development            # development | production
PORT=3001                       # HTTP 监听端口

# ── 会话签名密钥（auth.cjs 用 HMAC-SHA256 签 cookie JWT）──
# 生产环境务必改成随机长字符串；缺失时回退 'dev-only-change-me'（不安全）
JWT_SECRET=change-me-to-a-long-random-string

# ── PostgreSQL 主库连接 ──
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=huabu
PG_USER=postgres
PG_PASSWORD=your_postgres_password
PG_POOL_MAX=10                  # 连接池上限（高并发时调大，如 20-50）

# ── Redis（Phase 0 已启用：限流 / 缓存 / 队列）──
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
